{
  "name": "furfinder",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run typecheck && npm run validate:technology && npm run validate:contracts && npm test && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b && tsc -p tsconfig.api.json",
    "test:api": "tsc -p tsconfig.tests.json && node --test tests/*.test.mjs",
    "test": "npm run test:api",
    "validate:technology": "node scripts/validate-technology-catalog.mjs",
    "validate:contracts": "node scripts/validate-api-contracts.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@tanstack/react-query": "5.105.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3"
  }
}
