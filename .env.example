VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Public Cloudflare Turnstile site key (safe for browser use).
VITE_TURNSTILE_SITE_KEY=replace_with_turnstile_site_key

# Server-only values. Add to Vercel Environment Variables; never prefix with VITE_.
# SUPABASE_URL can reuse VITE_SUPABASE_URL when omitted.
SUPABASE_SECRET_KEY=sb_secret_replace_me
TURNSTILE_SECRET_KEY=replace_with_turnstile_secret_key
